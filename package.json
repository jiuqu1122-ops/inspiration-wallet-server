{
  "name": "inspiration-wallet-server",
  "version": "0.1.0",
  "private": true,
  "description": "Production backend for Inspiration Drawer authentication, wallets, quotas, and AI request orchestration.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "credits:grant": "node dist/cli/grant-credits.js",
    "client-assets:upload": "node dist/cli/upload-client-assets.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.3",
    "ali-oss": "^6.23.0",
    "fast-jwt": "^6.2.4",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "nodemailer": "^9.0.3",
    "prisma": "6.19.3",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.10"
  }
}

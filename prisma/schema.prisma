generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum LicenseEdition {
  TRIAL
  PRO
  ENTERPRISE
}

enum WalletLedgerType {
  GRANT
  RESERVE
  RELEASE
  CHARGE
  REFUND
  ADJUSTMENT
}

enum AiCapability {
  LLM
  VISION
  IMAGE
  IMAGE_NANO_BANANA
  IMAGE_NANO_BANANA_2
  IMAGE_NANO_BANANA_PRO_FAST
  IMAGE_NANO_BANANA_2_FAST
  IMAGE_NANO_BANANA_PRO_1K
  IMAGE_NANO_BANANA_DUAL_2K
  IMAGE_GPT
  IMAGE_GPT_1K
  IMAGE_GROK
  VIDEO
  VIDEO_MINIMAX
}

enum AiRequestStatus {
  PENDING
  RESERVED
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AiTaskType {
  AGENT_CHAT
  INSPIRATION_ANALYSIS
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AdminOperationType {
  PROVISION_LICENSE
  GRANT_CREDITS
  CREATE_PROVIDER
  UPDATE_PROVIDER
  DELETE_PROVIDER
  UPDATE_AUTHORIZATION
  ROUTE_REMAPPED
  ROUTE_UNMAPPED
  ROUTE_DISABLED
  DEFAULT_ROUTE_CHANGED
  MODEL_VISIBILITY_CHANGED
  MODEL_ENABLED_CHANGED
  PRICING_PENDING_UPDATED
  PRICING_PUBLISHED
  MODEL_ALIAS_CREATED
  MODEL_ALIAS_DELETED
  MODEL_DELETED
  USAGE_MODEL_BINDING_UPDATED
}

enum AiRouteExecutionMode {
  INHERIT
  DIRECT
  TASK
}

enum AiProviderKind {
  NEW_API
  XAIS
  MIKOTO
  BIGMODEL
  MINIMAX
  USELG
}

enum AiProviderStatus {
  ACTIVE
  DISABLED
}

enum CreditRedemptionCodeStatus {
  ACTIVE
  DISABLED
}

enum InspirationShareKind {
  NODE_PRESET
  WORKFLOW
  PROMPT
}

enum InspirationShareStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum ReferenceUploadStatus {
  ISSUED
  UPLOADED
}

enum MembershipStatus {
  ACTIVE
  REVOKED
}

model User {
  id                   String                       @id @default(cuid())
  email                String?                      @unique
  displayName          String?
  emailVerifiedAt      DateTime?
  entitlementExpiresAt DateTime?
  entitlementEdition   LicenseEdition               @default(ENTERPRISE)
  entitlementFeatures  String[]                     @default([])
  status               UserStatus                   @default(ACTIVE)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  licenses             License[]
  wallet               Wallet?
  ledger               WalletLedger[]
  aiRequests           AiRequest[]
  aiTasks              AiTask[]
  sessions             AuthSession[]
  adminOperations      AdminOperation[]
  emailChallenges      EmailVerificationChallenge[]
  creditRedemptions    CreditRedemption[]
  referenceUploads     ReferenceUpload[]
  memberships          UserMembership[]
  referralProfile      ReferralProfile?
  sentReferrals        ReferralRelation[]       @relation("ReferralInviter")
  receivedReferral     ReferralRelation?        @relation("ReferralInvitee")
  sentReferralRewards  ReferralRewardEvent[]    @relation("ReferralRewardInviter")
  receivedReferralRewards ReferralRewardEvent[] @relation("ReferralRewardInvitee")
  rechargeSessions     RechargeSession[]

  @@index([status])
}

model RechargeSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model MembershipPlan {
  id          String                    @id @default(cuid())
  code        String                    @unique
  name        String
  description String?
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  versions    MembershipPlanVersion[]
  memberships UserMembership[]

  @@index([active, updatedAt])
}

model MembershipPlanVersion {
  id          String         @id @default(cuid())
  planId      String
  version     Int
  prices      Json
  freeQuota   Json?
  publishedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())
  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId, publishedAt])
}

model UserMembership {
  id        String           @id @default(cuid())
  userId    String
  planId    String
  status    MembershipStatus @default(ACTIVE)
  startsAt  DateTime
  expiresAt DateTime
  source    String           @default("ADMIN")
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan      MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([planId, status, expiresAt])
}

model ReferralProfile {
  userId     String   @id
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReferralRelation {
  id         String   @id @default(cuid())
  inviterId  String
  inviteeId  String   @unique
  inviteCode String
  boundAt    DateTime @default(now())
  inviter    User     @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  invitee    User     @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  rewards    ReferralRewardEvent[]

  @@index([inviterId, boundAt])
  @@index([inviteCode, boundAt])
}

model ReferralRewardRule {
  id             String   @id @default(cuid())
  eventType      String   @unique
  inviterCredits Decimal  @default(0) @db.Decimal(24, 6)
  inviteeCredits Decimal  @default(0) @db.Decimal(24, 6)
  minRecharge    Decimal? @db.Decimal(24, 6)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  events         ReferralRewardEvent[]
}

model ReferralRewardEvent {
  id             String              @id @default(cuid())
  eventKey       String              @unique
  ruleId         String?
  relationId     String?
  inviterId      String
  inviteeId      String
  inviterCredits Decimal              @default(0) @db.Decimal(24, 6)
  inviteeCredits Decimal              @default(0) @db.Decimal(24, 6)
  createdAt      DateTime            @default(now())
  rule           ReferralRewardRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  relation       ReferralRelation?   @relation(fields: [relationId], references: [id], onDelete: SetNull)
  inviter        User                @relation("ReferralRewardInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  invitee        User                @relation("ReferralRewardInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)

  @@index([inviterId, createdAt])
  @@index([inviteeId, createdAt])
  @@index([relationId, createdAt])
}

model ReferenceUpload {
  id          String                @id @default(cuid())
  userId      String
  objectKey   String                @unique
  contentType String
  sizeBytes   Int
  status      ReferenceUploadStatus @default(ISSUED)
  expiresAt   DateTime
  uploadedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([userId, status, createdAt])
}

model AiTask {
  id          String       @id @default(cuid())
  userId      String
  type        AiTaskType
  status      AiTaskStatus @default(QUEUED)
  progress    Int          @default(0)
  stage       String       @default("queued")
  payload     Json
  result      Json?
  error       Json?
  requestId   String
  retryCount  Int          @default(0)
  workerId    String?
  heartbeatAt DateTime?
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, requestId])
  @@index([status, createdAt])
  @@index([status, heartbeatAt])
  @@index([userId, updatedAt])
}

model EmailVerificationChallenge {
  id         String    @id
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([expiresAt])
}

model License {
  id              String          @id @default(cuid())
  codeHash        String          @unique
  customer        String?
  machineIdHash   String?
  userId          String
  status          LicenseStatus   @default(ACTIVE)
  edition         LicenseEdition?
  features        String[]        @default([])
  expiresAt       DateTime?
  lastExchangedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions        AuthSession[]

  @@index([userId, status])
  @@index([machineIdHash, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id               String    @id
  userId           String
  licenseId        String?
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  license          License?  @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([licenseId, revokedAt])
  @@index([expiresAt])
}

model Wallet {
  userId           String   @id
  availableCredits Decimal  @default(0) @db.Decimal(24, 6)
  reservedCredits  Decimal  @default(0) @db.Decimal(24, 6)
  lifetimeGranted  Decimal  @default(0) @db.Decimal(24, 6)
  lifetimeConsumed Decimal  @default(0) @db.Decimal(24, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model WalletLedger {
  id           String           @id @default(cuid())
  userId       String
  requestId    String?
  type         WalletLedgerType
  amount       Decimal          @db.Decimal(24, 6)
  balanceAfter Decimal          @db.Decimal(24, 6)
  description  String?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  request      AiRequest?       @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([requestId])
}

model CreditRedemptionCode {
  id             String                     @id @default(cuid())
  codeHash       String                     @unique
  codeHint       String
  credits        Decimal                    @db.Decimal(24, 6)
  maxRedemptions Int                        @default(1)
  redeemedCount  Int                        @default(0)
  status         CreditRedemptionCodeStatus @default(ACTIVE)
  expiresAt      DateTime?
  note           String?
  createdAt      DateTime                   @default(now())
  redemptions    CreditRedemption[]

  @@index([status, expiresAt])
  @@index([createdAt])
}

model CreditRedemption {
  id        String               @id @default(cuid())
  codeId    String
  userId    String
  credits   Decimal              @db.Decimal(24, 6)
  createdAt DateTime             @default(now())
  code      CreditRedemptionCode @relation(fields: [codeId], references: [id], onDelete: Restrict)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([codeId, userId])
  @@index([userId, createdAt])
}

model AiRequest {
  id                String               @id @default(cuid())
  userId            String
  clientRequestId   String
  capability        AiCapability
  logicalModel      String
  canonicalModelId  String?
  routeId           String?
  priceVersionId    String?
  pricingSnapshot   Json?
  chargeBreakdown   Json?
  status            AiRequestStatus      @default(PENDING)
  estimatedCredits  Decimal              @default(0) @db.Decimal(24, 6)
  chargedCredits    Decimal              @default(0) @db.Decimal(24, 6)
  result            Json?
  /// Safe failure classification; no response bodies, prompts, secrets or image URLs.
  failureDiagnostic Json?
  createdAt         DateTime             @default(now())
  completedAt       DateTime?
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries     WalletLedger[]
  canonicalModel    AiModel?             @relation(fields: [canonicalModelId], references: [id], onDelete: SetNull)
  route             AiModelRoute?        @relation(fields: [routeId], references: [id], onDelete: SetNull)
  priceVersion      AiPriceVersion?      @relation(fields: [priceVersionId], references: [id], onDelete: SetNull)
  billingSettlement AiBillingSettlement?
  videoTasks         AiVideoTask[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([canonicalModelId, createdAt])
  @@index([routeId, createdAt])
  @@index([priceVersionId])
}

model AdminOperation {
  id             String             @id @default(cuid())
  idempotencyKey String             @unique
  type           AdminOperationType
  userId         String?
  amount         Decimal?           @db.Decimal(24, 6)
  description    String?
  result         Json
  createdAt      DateTime           @default(now())
  user           User?              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model AiProviderChannel {
  id                 String                @id @default(cuid())
  name               String                @unique
  kind               AiProviderKind
  status             AiProviderStatus      @default(ACTIVE)
  priority           Int                   @default(100)
  baseUrl            String
  defaultModel       String?
  allowInsecureHttp  Boolean               @default(false)
  encryptedSecrets   String
  apiKeyLast4        String
  capabilities       AiCapability[]
  lastTestStatus     String?
  lastTestMessage    String?
  lastTestModelCount Int?
  lastTestedAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  modelRoutes        AiModelRoute[]
  modelDiscoveries   AiUpstreamDiscovery[]

  @@index([kind, status])
  @@index([status, priority])
  @@index([updatedAt])
}

model AiPricingConfig {
  id                         String   @id @default("default")
  agentRequestCredits        BigInt
  inspirationAnalysisCredits BigInt
  canvasTextAgentCredits     BigInt
  imageDefaultCredits        BigInt
  videoDefaultCredits        BigInt
  imageModelPrices           Json
  videoModelPrices           Json
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

/// User-facing, provider-independent AI product identity.
model AiModel {
  id                 String                @id @default(cuid())
  canonicalModelKey  String                @unique
  displayName        String
  modality           String
  enabled            Boolean               @default(false)
  visible            Boolean               @default(false)
  sortOrder          Int                   @default(100)
  billingType        String
  routingMode        String                @default("LEGACY")
  capabilities       Json                  @default("{}")
  defaultRouteId     String?               @unique
  status             String                @default("DRAFT")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  defaultRoute       AiModelRoute?         @relation("DefaultAiModelRoute", fields: [defaultRouteId], references: [id], onDelete: SetNull)
  routes             AiModelRoute[]        @relation("AiModelRoutes")
  aliases            AiModelAlias[]
  pricing            AiModelPricing?
  priceVersions      AiPriceVersion[]
  requests           AiRequest[]
  billingSettlements AiBillingSettlement[]
  usageBindings      AiUsageModelBinding[]

  @@index([modality, enabled, visible, sortOrder])
  @@index([status, modality])
}

/// Server-owned binding from an internal business purpose to a canonical Chat model.
model AiUsageModelBinding {
  key              String   @id
  canonicalModelId String
  fixedCredits     Decimal? @db.Decimal(18, 6)
  updatedAt        DateTime @updatedAt
  canonicalModel   AiModel  @relation(fields: [canonicalModelId], references: [id], onDelete: Restrict)

  @@index([canonicalModelId])
}

/// Provider/channel-specific route and upstream purchasing cost.
model AiModelRoute {
  id                   String                @id @default(cuid())
  canonicalModelId     String?
  provider             String
  channelId            String?
  upstreamModelId      String
  enabled              Boolean               @default(false)
  priority             Int                   @default(100)
  healthStatus         String                @default("UNKNOWN")
  upstreamAvailable    Boolean               @default(false)
  lastSyncedAt         DateTime?
  costProfile          Json?
  capabilitiesOverride Json?
  adapterKey           String?
  adapterConfig        Json?
  executionMode        AiRouteExecutionMode @default(INHERIT)
  executionConfig      Json?
  metadata             Json?
  pricingSyncStatus    String                @default("UNKNOWN")
  costUpdatedAt        DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  canonicalModel       AiModel?              @relation("AiModelRoutes", fields: [canonicalModelId], references: [id], onDelete: Restrict)
  channel              AiProviderChannel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  defaultForModel      AiModel?              @relation("DefaultAiModelRoute")
  requests             AiRequest[]
  costHistory          AiRouteCostHistory[]
  billingSettlements   AiBillingSettlement[]
  videoTasks           AiVideoTask[]

  @@unique([provider, channelId, upstreamModelId])
  @@index([canonicalModelId, enabled, priority])
  @@index([channelId, enabled, priority])
  @@index([provider, upstreamModelId])
}

/// Explicitly confirmed compatibility alias. Alias normalization is lookup-only;
/// it never creates mappings by fuzzy matching.
model AiModelAlias {
  id               String   @id @default(cuid())
  canonicalModelId String
  modality         String
  alias            String
  aliasKey         String
  source           String   @default("ADMIN")
  confirmed        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  canonicalModel   AiModel  @relation(fields: [canonicalModelId], references: [id], onDelete: Cascade)

  @@unique([modality, aliasKey])
  @@index([canonicalModelId])
}

/// Immutable user sell-price version for one canonical model.
model AiPriceVersion {
  id                 String                @id @default(cuid())
  canonicalModelId   String
  version            Int
  pricing            Json
  source             String                @default("MANUAL")
  publishedBy        String?
  createdAt          DateTime              @default(now())
  publishedAt        DateTime              @default(now())
  canonicalModel     AiModel               @relation(fields: [canonicalModelId], references: [id], onDelete: Restrict)
  currentFor         AiModelPricing?       @relation("CurrentAiPriceVersion")
  requests           AiRequest[]
  billingSettlements AiBillingSettlement[]

  @@unique([canonicalModelId, version])
  @@index([canonicalModelId, publishedAt])
}

/// Mutable pricing workspace. Only currentVersionId is used for live billing.
model AiModelPricing {
  canonicalModelId String          @id
  currentVersionId String?         @unique
  pendingPrice     Json?
  suggestedPrice   Json?
  pricingMode      String          @default("MANUAL")
  markupMultiplier Decimal         @default(1.32) @db.Decimal(12, 6)
  updatedAt        DateTime        @updatedAt
  canonicalModel   AiModel         @relation(fields: [canonicalModelId], references: [id], onDelete: Cascade)
  currentVersion   AiPriceVersion? @relation("CurrentAiPriceVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
}

/// Upstream models awaiting an explicit administrator mapping decision.
model AiUpstreamDiscovery {
  id                String            @id @default(cuid())
  provider          String
  channelId         String
  upstreamModelId   String
  suggestedModality String?
  modalityOverride  String?
  availability      String            @default("UNKNOWN")
  capabilities      Json?
  context           Json?
  resolution        Json?
  duration          Json?
  discoveredCost    Json?
  metadata          Json?
  status            String            @default("UNMAPPED")
  suggestedModelId  String?
  lastSyncedAt      DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  channel           AiProviderChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, upstreamModelId])
  @@index([status, lastSyncedAt])
  @@index([provider, upstreamModelId])
}

model AiRouteCostHistory {
  id                String       @id @default(cuid())
  routeId           String
  costProfile       Json
  pricingSyncStatus String       @default("OK")
  observedAt        DateTime     @default(now())
  route             AiModelRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, observedAt])
}

/// One authoritative charge per logical AI request. This table supplies a new
/// uniqueness boundary without rewriting historical wallet ledger rows.
model AiBillingSettlement {
  id               String          @id @default(cuid())
  requestId        String          @unique
  canonicalModelId String?
  routeId          String?
  priceVersionId   String?
  chargedCredits   Decimal         @db.Decimal(24, 6)
  breakdown        Json
  createdAt        DateTime        @default(now())
  request          AiRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  canonicalModel   AiModel?        @relation(fields: [canonicalModelId], references: [id], onDelete: SetNull)
  route            AiModelRoute?   @relation(fields: [routeId], references: [id], onDelete: SetNull)
  priceVersion     AiPriceVersion? @relation(fields: [priceVersionId], references: [id], onDelete: SetNull)

  @@index([canonicalModelId, createdAt])
  @@index([routeId, createdAt])
  @@index([priceVersionId])
}

/// One independently pollable upstream task per requested video output.
/// This is additive: historical AiRequest rows remain unchanged.
model AiVideoTask {
  id                String       @id @default(cuid())
  requestId         String
  routeId           String?
  outputIndex       Int
  upstreamTaskId    String?
  status            String       @default("RESERVED")
  assetState        String?
  videoAvailable    Boolean?
  pollAfterMs       Int?
  lastPolledAt      DateTime?
  resultObjectKey   String?
  resultUrl         String?
  upstreamPayload   Json?
  lastError         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  completedAt       DateTime?
  request           AiRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  route             AiModelRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@unique([requestId, outputIndex])
  @@unique([routeId, upstreamTaskId])
  @@index([requestId, status])
  @@index([routeId, status])
  @@index([status, lastPolledAt])
}

model ChatPricingConfig {
  id          String   @id @default("default")
  modelPrices Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InspirationShare {
  id            String                    @id
  kind          InspirationShareKind
  status        InspirationShareStatus    @default(PENDING)
  title         String
  description   String?
  authorName    String
  tags          String[]                  @default([])
  fileName      String
  jsonPayload   Json
  downloadCount Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  publishedAt   DateTime?
  previews      InspirationSharePreview[]

  @@index([status, createdAt])
  @@index([kind, status, createdAt])
}

model InspirationSharePreview {
  id        String           @id
  shareId   String
  objectKey String           @unique
  mimeType  String
  width     Int
  height    Int
  sizeBytes Int
  sortOrder Int
  createdAt DateTime         @default(now())
  share     InspirationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, sortOrder])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum LicenseEdition {
  TRIAL
  PRO
  ENTERPRISE
}

enum WalletLedgerType {
  GRANT
  RESERVE
  RELEASE
  CHARGE
  REFUND
  ADJUSTMENT
}

enum AiCapability {
  LLM
  VISION
  IMAGE
  IMAGE_NANO_BANANA
  IMAGE_GPT
  VIDEO
}

enum AiRequestStatus {
  PENDING
  RESERVED
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AiTaskType {
  AGENT_CHAT
  INSPIRATION_ANALYSIS
}

enum AiTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AdminOperationType {
  PROVISION_LICENSE
  GRANT_CREDITS
  CREATE_PROVIDER
  UPDATE_PROVIDER
  UPDATE_AUTHORIZATION
}

enum AiProviderKind {
  NEW_API
  XAIS
}

enum AiProviderStatus {
  ACTIVE
  DISABLED
}

enum CreditRedemptionCodeStatus {
  ACTIVE
  DISABLED
}

enum InspirationShareKind {
  NODE_PRESET
  WORKFLOW
}

enum InspirationShareStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id                   String                       @id @default(cuid())
  email                String?                      @unique
  displayName          String?
  emailVerifiedAt      DateTime?
  entitlementExpiresAt DateTime?
  entitlementEdition   LicenseEdition               @default(ENTERPRISE)
  entitlementFeatures  String[]                     @default([])
  status               UserStatus                   @default(ACTIVE)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  licenses             License[]
  wallet               Wallet?
  ledger               WalletLedger[]
  aiRequests           AiRequest[]
  aiTasks              AiTask[]
  sessions             AuthSession[]
  adminOperations      AdminOperation[]
  emailChallenges      EmailVerificationChallenge[]
  creditRedemptions    CreditRedemption[]

  @@index([status])
}

model AiTask {
  id          String       @id @default(cuid())
  userId      String
  type        AiTaskType
  status      AiTaskStatus @default(QUEUED)
  progress    Int          @default(0)
  stage       String       @default("queued")
  payload     Json
  result      Json?
  error       Json?
  requestId   String
  retryCount  Int          @default(0)
  workerId    String?
  heartbeatAt DateTime?
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, requestId])
  @@index([status, createdAt])
  @@index([status, heartbeatAt])
  @@index([userId, updatedAt])
}

model EmailVerificationChallenge {
  id         String    @id
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([expiresAt])
}

model License {
  id              String          @id @default(cuid())
  codeHash        String          @unique
  customer        String?
  machineIdHash   String?
  userId          String
  status          LicenseStatus   @default(ACTIVE)
  edition         LicenseEdition?
  features        String[]        @default([])
  expiresAt       DateTime?
  lastExchangedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions        AuthSession[]

  @@index([userId, status])
  @@index([machineIdHash, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id               String    @id
  userId           String
  licenseId        String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  license          License   @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([licenseId, revokedAt])
  @@index([expiresAt])
}

model Wallet {
  userId           String   @id
  availableCredits BigInt   @default(0)
  reservedCredits  BigInt   @default(0)
  lifetimeGranted  BigInt   @default(0)
  lifetimeConsumed BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model WalletLedger {
  id           String           @id @default(cuid())
  userId       String
  requestId    String?
  type         WalletLedgerType
  amount       BigInt
  balanceAfter BigInt
  description  String?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  request      AiRequest?       @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([requestId])
}

model CreditRedemptionCode {
  id             String                     @id @default(cuid())
  codeHash       String                     @unique
  codeHint       String
  credits        BigInt
  maxRedemptions Int                        @default(1)
  redeemedCount  Int                        @default(0)
  status         CreditRedemptionCodeStatus @default(ACTIVE)
  expiresAt      DateTime?
  note           String?
  createdAt      DateTime                   @default(now())
  redemptions    CreditRedemption[]

  @@index([status, expiresAt])
  @@index([createdAt])
}

model CreditRedemption {
  id        String               @id @default(cuid())
  codeId    String
  userId    String
  credits   BigInt
  createdAt DateTime             @default(now())
  code      CreditRedemptionCode @relation(fields: [codeId], references: [id], onDelete: Restrict)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([codeId, userId])
  @@index([userId, createdAt])
}

model AiRequest {
  id               String          @id @default(cuid())
  userId           String
  clientRequestId  String
  capability       AiCapability
  logicalModel     String
  status           AiRequestStatus @default(PENDING)
  estimatedCredits BigInt          @default(0)
  chargedCredits   BigInt          @default(0)
  createdAt        DateTime        @default(now())
  completedAt      DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries    WalletLedger[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AdminOperation {
  id             String             @id @default(cuid())
  idempotencyKey String             @unique
  type           AdminOperationType
  userId         String?
  amount         BigInt?
  description    String?
  result         Json
  createdAt      DateTime           @default(now())
  user           User?              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model AiProviderChannel {
  id                 String           @id @default(cuid())
  name               String           @unique
  kind               AiProviderKind
  status             AiProviderStatus @default(ACTIVE)
  priority           Int              @default(100)
  baseUrl            String
  defaultModel       String?
  allowInsecureHttp  Boolean          @default(false)
  encryptedSecrets   String
  apiKeyLast4        String
  capabilities       AiCapability[]
  lastTestStatus     String?
  lastTestMessage    String?
  lastTestModelCount Int?
  lastTestedAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([kind, status])
  @@index([status, priority])
  @@index([updatedAt])
}

model AiPricingConfig {
  id                         String   @id @default("default")
  agentRequestCredits        BigInt
  inspirationAnalysisCredits BigInt
  imageDefaultCredits        BigInt
  videoDefaultCredits        BigInt
  imageModelPrices           Json
  videoModelPrices           Json
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model InspirationShare {
  id            String                 @id
  kind          InspirationShareKind
  status        InspirationShareStatus @default(PENDING)
  title         String
  description   String?
  authorName    String
  tags          String[]               @default([])
  fileName      String
  jsonPayload   Json
  downloadCount Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  publishedAt   DateTime?
  previews      InspirationSharePreview[]

  @@index([status, createdAt])
  @@index([kind, status, createdAt])
}

model InspirationSharePreview {
  id         String           @id
  shareId    String
  objectKey  String           @unique
  mimeType   String
  width      Int
  height     Int
  sizeBytes  Int
  sortOrder  Int
  createdAt  DateTime         @default(now())
  share      InspirationShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, sortOrder])
}

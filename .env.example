# Copy this file to .env and replace every CHANGE_ME value before starting.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=https://api.unmind.art

POSTGRES_DB=inspiration_wallet
POSTGRES_USER=inspiration_wallet
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://inspiration_wallet:CHANGE_ME@postgres:5432/inspiration_wallet?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Public Ed25519 key embedded by the current Inspiration Drawer license issuer.
# This is public verification material, not a secret.
LICENSE_SIGNING_PUBLIC_KEY=AAS4rzI5dxFefYmQCNp1wYpYgKwMXp5+wG1WgF/UoRQ=

# Secret Base64-encoded 32-byte Ed25519 private seed matching the public key above.
# Required only for automatic 30-day trial registration. Never commit the real value.
LICENSE_SIGNING_PRIVATE_KEY=

# SHA-256 hex digest of the administrator key used only by the private Tauri workbench.
# Leave empty to disable all /v1/admin endpoints.
ADMIN_API_KEY_HASH=

# Base64-encoded 32-byte AES key used to encrypt upstream provider API keys in PostgreSQL.
# Generate once with: openssl rand -base64 32
# Keep this value stable and backed up. Losing it makes saved provider credentials unreadable.
PROVIDER_SECRETS_ENCRYPTION_KEY=

# Comma-separated exact origins. Leave empty to reject browser cross-origin requests.
# Example Tauri values must be confirmed against the packaged client before production use.
CORS_ALLOWED_ORIGINS=

# Contact used by Caddy's ACME certificate issuer.
CADDY_ACME_EMAIL=admin@unmind.art
